#!/usr/bin/env bash

set -euo pipefail

source "$HOME/git/Cravo-Toolkit/lib/ctk_functions.sh"

MODE="list"
ID=""

usage()
{
cat <<EOF

ctk-history

USO

  ctk-history

  ctk-history --show ID

OPÇÕES

  --show ID
  --help

EXEMPLOS

  ctk-history

  ctk-history \
      --show 20261120T213343Z_c4152ffb48c6eeb1

EOF
}

while [[ $# -gt 0 ]]
do
    case "$1" in

        --show)
            MODE="show"
            ID="$2"
            shift 2
            ;;

        --help|-h)
            usage
            exit 0
            ;;

        *)
            echo "Opção inválida: $1"
            exit 1
            ;;
    esac
done

case "$MODE" in

    list)

        ctkbu_list
        ;;

    show)

        FILE="$HOME/.ctk_bu/${ID}.ctkbu"

        if [[ ! -f "$FILE" ]]
        then
            echo "Backup não encontrado:"
            echo "$FILE"
            exit 1
        fi

        ctkbu_info "$FILE"
        ;;

esac
